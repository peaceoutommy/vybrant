# Clerk: Dashboard > API keys (the secret one, never the publishable one; sk_live_... in production)
CLERK_SECRET_KEY=sk_test_...
# The website's origin: only session tokens made there are accepted, and CORS allows it (https://... in production)
WEB_ORIGIN=http://localhost:5173
# From `npm run keygen`. Whoever has it can make Vybrant licenses: keep it out of git and back it up
LICENSE_PRIVATE_KEY=
# 3000 is what Caddy forwards to (Caddyfile)
PORT=3000
# Deployment (compose.yaml): the API's public name, served over HTTPS by Caddy
API_DOMAIN=api.example.com
